  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Solar Minimum is the period when the Sun\u2019s activity is at its lowest,
    with few sunspots and minimal solar flares.\n\nSolar Maximum is when solar activity
    peaks, resulting in more sunspots, intense solar flares, and frequent coronal
    mass ejections.\L \nThese phases impact Earth\u2019s magnetosphere and can create
    beautiful auroras as well as disruptions in communication and navigation systems."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c1a6766cc90ee6042bda611a62866980, type: 2}
  m_sharedMaterial: {fileID: 7840408960139126525, guid: c1a6766cc90ee6042bda611a62866980, type: 2}
