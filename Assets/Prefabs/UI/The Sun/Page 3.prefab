  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Sun\u2019s atmosphere has three main layers: the photosphere, chromosphere,
    and corona.\n\n1. <indent=50>Photosphere: This is the visible surface of the
    Sun, where light is emitted. </indent>\n2. <indent=50>Chromosphere: A thin layer
    above the photosphere, visible during solar eclipses as a reddish glow. It is
    a region of rising temperatures and active magnetic phenomena.</indent>\n3. <indent=50>Corona:
    The Sun\u2019s outermost layer, extending millions of kilometers into space.
    It is much hotter than the surface and is the source of the solar wind that affects
    space weather near Earth.</indent>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c1a6766cc90ee6042bda611a62866980, type: 2}
  m_sharedMaterial: {fileID: 7840408960139126525, guid: c1a6766cc90ee6042bda611a62866980, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4294967295
